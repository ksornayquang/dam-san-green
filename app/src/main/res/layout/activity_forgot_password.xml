<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ds_background"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="32dp">

        <View
            android:id="@+id/topBanner"
            android:layout_width="match_parent"
            android:layout_height="190dp"
            android:background="@drawable/bg_login_top"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="16dp"
            android:layout_marginTop="40dp"
            android:src="@drawable/ic_back"
            android:background="@drawable/bg_icon_circle_glass"
            android:scaleType="center"
            android:contentDescription="Quay lại"
            app:tint="@color/white"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>

        <LinearLayout
            android:id="@+id/headerContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="24dp"
            android:layout_marginTop="96dp"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:layout_width="54dp"
                android:layout_height="54dp"
                android:src="@drawable/ic_lock"
                android:padding="13dp"
                android:background="@drawable/bg_icon_circle_glass"
                app:tint="@color/white"
                android:contentDescription="Khôi phục mật khẩu"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Khôi phục mật khẩu"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="@color/white"
                    android:fontFamily="@font/be_vietnam_pro_bold"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Gửi email đặt lại mật khẩu cho tài khoản lớp"
                    android:textSize="12sp"
                    android:textColor="@color/text_white_secondary"
                    android:fontFamily="@font/be_vietnam_pro"
                    android:layout_marginTop="2dp"/>
            </LinearLayout>
        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/resetCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="24dp"
            android:layout_marginTop="-16dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="10dp"
            app:cardBackgroundColor="@color/ds_surface"
            app:layout_constraintTop_toBottomOf="@id/topBanner">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <TextView
                    style="@style/DS.SectionHeader"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CHỌN LỚP"
                    android:layout_marginBottom="8dp"/>

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="62dp"
                    android:background="@drawable/bg_spinner_ds"
                    android:layout_marginBottom="18dp">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_user"
                        android:layout_gravity="start|center_vertical"
                        android:layout_marginStart="16dp"
                        app:tint="@color/ds_text_secondary"/>

                    <Spinner
                        android:id="@+id/spinnerResetClass"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:paddingStart="44dp"
                        android:paddingEnd="40dp"
                        android:popupBackground="@drawable/bg_spinner_dropdown_popup"
                        android:dropDownVerticalOffset="8dp"
                        android:dropDownWidth="match_parent"
                        android:background="@android:color/transparent"
                        android:fontFamily="@font/be_vietnam_pro"/>

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_dropdown"
                        android:layout_gravity="end|center_vertical"
                        android:layout_marginEnd="16dp"
                        app:tint="@color/ds_text_secondary"/>
                </FrameLayout>

                <TextView
                    style="@style/DS.SectionHeader"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="EMAIL NHẬN LINK"
                    android:layout_marginBottom="8dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="14dp"
                    android:background="@drawable/bg_email_preview"
                    android:layout_marginBottom="18dp">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_mail"
                        app:tint="@color/ds_primary"
                        android:layout_marginEnd="10dp"/>

                    <TextView
                        android:id="@+id/tvResetEmail"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="11a1@damsan.edu.vn"
                        android:textSize="14sp"
                        android:textColor="@color/ds_text_primary"
                        android:fontFamily="@font/be_vietnam_pro_medium"/>
                </LinearLayout>

                <FrameLayout
                    android:id="@+id/btnSendReset"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:background="@drawable/bg_btn_primary"
                    android:elevation="4dp"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:id="@+id/tvSendResetText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Gửi email khôi phục"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/white"
                        android:fontFamily="@font/be_vietnam_pro_semibold"
                        android:layout_gravity="center"/>

                    <ProgressBar
                        android:id="@+id/progressReset"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:indeterminateTint="@color/white"
                        android:visibility="gone"/>
                </FrameLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Nếu lớp dùng email chung, hãy mở hộp thư của lớp hoặc nhờ giáo viên phụ trách kiểm tra link khôi phục."
                    android:textSize="12sp"
                    android:textColor="@color/ds_text_secondary"
                    android:fontFamily="@font/be_vietnam_pro"
                    android:lineSpacingExtra="3dp"
                    android:layout_marginTop="16dp"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>

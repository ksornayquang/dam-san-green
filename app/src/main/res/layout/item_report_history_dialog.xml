<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_history_item"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="12dp">

    <FrameLayout
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:background="@drawable/bg_history_summary">

        <ImageView
            android:id="@+id/ivHistoryStatus"
            android:layout_width="19dp"
            android:layout_height="19dp"
            android:layout_gravity="center"
            android:contentDescription="Trạng thái"
            android:src="@drawable/ic_check"
            app:tint="@color/ds_success" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="8dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvHistoryReporter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/be_vietnam_pro_semibold"
            android:letterSpacing="0"
            android:maxLines="1"
            android:text="Y Tú"
            android:textColor="@color/ds_text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvHistoryTime"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:fontFamily="@font/be_vietnam_pro_regular"
            android:letterSpacing="0"
            android:maxLines="1"
            android:text="13/06 00:30"
            android:textColor="@color/ds_text_secondary"
            android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvHistoryStatus"
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:background="@drawable/bg_status_chip_success"
            android:fontFamily="@font/be_vietnam_pro_semibold"
            android:gravity="center"
            android:letterSpacing="0"
            android:minWidth="76dp"
            android:paddingHorizontal="10dp"
            android:text="Đã duyệt"
            android:textColor="@color/ds_success"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/tvHistoryPoints"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="4dp"
            android:fontFamily="@font/be_vietnam_pro_bold"
            android:letterSpacing="0"
            android:text="+0đ"
            android:textColor="@color/ds_primary"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>

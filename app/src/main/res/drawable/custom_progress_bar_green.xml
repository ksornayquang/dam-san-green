<?xml version="1.0" encoding="utf-8"?>
<!-- Green progress bar with new teal -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape>
            <corners android:topLeftRadius="6dp" android:bottomLeftRadius="6dp" android:topRightRadius="0dp" android:bottomRightRadius="0dp"/>
            <solid android:color="#E6EEED"/>
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <clip>
            <shape>
                <corners android:topLeftRadius="6dp" android:bottomLeftRadius="6dp" android:topRightRadius="0dp" android:bottomRightRadius="0dp"/>
                <solid android:color="#14454F"/>
            </shape>
        </clip>
    </item>
</layer-list>

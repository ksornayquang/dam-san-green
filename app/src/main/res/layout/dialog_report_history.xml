<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_dialog_surface"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <FrameLayout
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:background="@drawable/bg_history_summary">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:contentDescription="Lịch sử"
                android:src="@drawable/ic_history"
                app:tint="@color/ds_primary" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvHistoryTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/be_vietnam_pro_bold"
                android:letterSpacing="0"
                android:text="Lịch sử báo cáo"
                android:textColor="@color/ds_text_primary"
                android:textSize="19sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvHistorySubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/be_vietnam_pro_regular"
                android:letterSpacing="0"
                android:text="Đang tải dữ liệu..."
                android:textColor="@color/ds_text_secondary"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/tvHistorySummary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_history_summary"
        android:fontFamily="@font/be_vietnam_pro_semibold"
        android:letterSpacing="0"
        android:lineSpacingExtra="2dp"
        android:paddingHorizontal="14dp"
        android:paddingVertical="11dp"
        android:text="Đang đồng bộ báo cáo của lớp..."
        android:textColor="@color/ds_primary_dark"
        android:textSize="13sp" />

    <ScrollView
        android:id="@+id/historyScroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:fadingEdge="vertical"
        android:overScrollMode="ifContentScrolls">

        <LinearLayout
            android:id="@+id/historyRows"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

    <TextView
        android:id="@+id/tvHistoryEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_history_item"
        android:fontFamily="@font/be_vietnam_pro_regular"
        android:gravity="center"
        android:letterSpacing="0"
        android:lineSpacingExtra="3dp"
        android:padding="18dp"
        android:text="Chưa có báo cáo nào.\nHãy bắt đầu bằng một lần nhặt rác hôm nay."
        android:textColor="@color/ds_text_secondary"
        android:textSize="13sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tvHistoryMore"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:fontFamily="@font/be_vietnam_pro_medium"
        android:gravity="center"
        android:letterSpacing="0"
        android:textColor="@color/ds_text_secondary"
        android:textSize="12sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/btnHistoryClose"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_btn_solid_green"
        android:clickable="true"
        android:focusable="true"
        android:fontFamily="@font/be_vietnam_pro_semibold"
        android:foreground="?attr/selectableItemBackground"
        android:gravity="center"
        android:letterSpacing="0"
        android:text="Đã hiểu"
        android:textColor="@color/white"
        android:textSize="14sp"
        android:textStyle="bold" />
</LinearLayout>

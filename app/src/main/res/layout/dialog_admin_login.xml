<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="8dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:fontFamily="@font/be_vietnam_pro"
        android:lineSpacingExtra="3dp"
        android:text="Dành cho tài khoản admin riêng đã được gán quyền trong Firebase."
        android:textColor="@color/ds_text_secondary"
        android:textSize="13sp" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilAdminEmail"
        style="@style/DS.TextInputLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:hint="Email admin"
        app:errorEnabled="true"
        app:startIconDrawable="@drawable/ic_mail"
        app:startIconTint="@color/ds_text_secondary">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etAdminEmail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/be_vietnam_pro"
            android:inputType="textEmailAddress"
            android:singleLine="true"
            android:textColor="@color/ds_text_primary"
            android:textSize="15sp" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilAdminPassword"
        style="@style/DS.TextInputLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Mật khẩu admin"
        app:endIconDrawable="@drawable/ic_eye"
        app:endIconMode="password_toggle"
        app:endIconTint="@color/ds_text_secondary"
        app:errorEnabled="true"
        app:startIconDrawable="@drawable/ic_lock"
        app:startIconTint="@color/ds_text_secondary">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etAdminPassword"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/be_vietnam_pro"
            android:inputType="textPassword"
            android:singleLine="true"
            android:textColor="@color/ds_text_primary"
            android:textSize="15sp" />
    </com.google.android.material.textfield.TextInputLayout>

    <ProgressBar
        android:id="@+id/progressAdminLogin"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="12dp"
        android:indeterminateTint="@color/ds_primary"
        android:visibility="gone" />
</LinearLayout>

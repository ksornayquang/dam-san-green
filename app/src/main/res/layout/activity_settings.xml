<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ds_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="32dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="210dp"
            android:background="@drawable/bg_login_top">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="16dp"
                android:layout_marginTop="40dp"
                android:src="@drawable/ic_back"
                android:background="@drawable/bg_icon_circle_glass"
                android:scaleType="center"
                android:contentDescription="Quay lại"
                app:tint="@color/white"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_gravity="bottom"
                android:paddingHorizontal="24dp"
                android:paddingBottom="24dp">

                <ImageView
                    android:layout_width="54dp"
                    android:layout_height="54dp"
                    android:src="@drawable/ic_settings"
                    android:padding="13dp"
                    android:background="@drawable/bg_icon_circle_glass"
                    app:tint="@color/white"
                    android:contentDescription="Cài đặt"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Cài đặt Dam San Green"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:textColor="@color/white"
                        android:fontFamily="@font/be_vietnam_pro_bold"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Branding, banner và thông tin hiển thị"
                        android:textSize="12sp"
                        android:textColor="@color/text_white_secondary"
                        android:fontFamily="@font/be_vietnam_pro"
                        android:layout_marginTop="2dp"/>
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="24dp"
            android:layout_marginTop="-28dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="10dp"
            app:cardBackgroundColor="@color/ds_surface">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    style="@style/DS.SectionHeader"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="XEM TRƯỚC BANNER"
                    android:layout_marginBottom="10dp"/>

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="150dp"
                    android:background="@drawable/bg_login_top"
                    android:layout_marginBottom="22dp">

                    <ImageView
                        android:id="@+id/ivBannerPreview"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:visibility="gone"
                        android:contentDescription="Banner preview"/>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_bottom_fade"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_gravity="bottom"
                        android:padding="16dp">

                        <ImageView
                            android:layout_width="34dp"
                            android:layout_height="34dp"
                            android:src="@drawable/ic_leaf"
                            app:tint="@color/white"
                            android:layout_marginEnd="10dp"/>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvPreviewAppName"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Dam San Green"
                                android:textSize="18sp"
                                android:textStyle="bold"
                                android:textColor="@color/white"
                                android:fontFamily="@font/be_vietnam_pro_bold"/>

                            <TextView
                                android:id="@+id/tvPreviewSchoolName"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Trường PTDTNT THPT Đam San"
                                android:textSize="11sp"
                                android:textColor="@color/text_white_secondary"
                                android:fontFamily="@font/be_vietnam_pro"/>
                        </LinearLayout>
                    </LinearLayout>
                </FrameLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/DS.TextInputLayout"
                    android:hint="Tên app"
                    app:startIconDrawable="@drawable/ic_leaf"
                    android:layout_marginBottom="14dp">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etAppName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        style="@style/DS.TextInputEditText"
                        android:inputType="textCapWords"/>
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/DS.TextInputLayout"
                    android:hint="Tên trường"
                    app:startIconDrawable="@drawable/ic_home"
                    android:layout_marginBottom="14dp">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etSchoolName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        style="@style/DS.TextInputEditText"
                        android:inputType="textCapSentences"/>
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/DS.TextInputLayout"
                    android:hint="Banner URL"
                    app:startIconDrawable="@drawable/ic_camera"
                    android:layout_marginBottom="14dp">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etBannerUrl"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        style="@style/DS.TextInputEditText"
                        android:inputType="textUri"
                        android:singleLine="true"/>
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/DS.TextInputLayout"
                    android:hint="Logo URL"
                    app:startIconDrawable="@drawable/ic_sparkle"
                    android:layout_marginBottom="18dp">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etLogoUrl"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        style="@style/DS.TextInputEditText"
                        android:inputType="textUri"
                        android:singleLine="true"/>
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/DS.TextInputLayout"
                    android:hint="Ảnh giới thiệu trường"
                    app:startIconDrawable="@drawable/ic_camera"
                    android:layout_marginBottom="14dp">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etSchoolImages"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        style="@style/DS.TextInputEditText"
                        android:gravity="top"
                        android:hint="Mỗi dòng một URL ảnh Cloudinary"
                        android:inputType="textMultiLine|textUri"
                        android:minLines="3"
                        android:maxLines="5"
                        android:singleLine="false"/>
                </com.google.android.material.textfield.TextInputLayout>

                <FrameLayout
                    android:id="@+id/btnUploadSchoolImage"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginBottom="18dp"
                    android:background="@drawable/bg_btn_secondary"
                    android:clickable="true"
                    android:focusable="true">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:contentDescription="Upload ảnh trường"
                            android:src="@drawable/ic_camera"
                            app:tint="@color/white" />

                        <TextView
                            android:id="@+id/tvUploadSchoolImageText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:fontFamily="@font/be_vietnam_pro_semibold"
                            android:text="Chọn ảnh trường và upload Cloudinary"
                            android:textColor="@color/white"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </FrameLayout>

                <TextView
                    style="@style/DS.SectionHeader"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:text="TẠO BẢN TIN NHANH" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:fontFamily="@font/be_vietnam_pro"
                    android:lineSpacingMultiplier="1.35"
                    android:text="Cập nhật tin môi trường, lao động, hoạt động Đoàn. Có thể chọn ảnh, app sẽ tự upload Cloudinary và gắn vào bản tin."
                    android:textColor="@color/ds_text_secondary"
                    android:textSize="12sp" />

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/DS.TextInputLayout"
                    android:hint="Tiêu đề bản tin"
                    app:startIconDrawable="@drawable/ic_info"
                    android:layout_marginBottom="12dp">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etNewsTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        style="@style/DS.TextInputEditText"
                        android:inputType="textCapSentences"
                        android:singleLine="true" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/DS.TextInputLayout"
                    android:hint="Nội dung ngắn"
                    app:startIconDrawable="@drawable/ic_edit"
                    android:layout_marginBottom="12dp">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etNewsBody"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        style="@style/DS.TextInputEditText"
                        android:gravity="top"
                        android:inputType="textMultiLine|textCapSentences"
                        android:minLines="2"
                        android:maxLines="4"
                        android:singleLine="false" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/DS.TextInputLayout"
                    android:hint="Ảnh bản tin URL"
                    app:startIconDrawable="@drawable/ic_camera"
                    android:layout_marginBottom="12dp">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etNewsImageUrl"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        style="@style/DS.TextInputEditText"
                        android:hint="Có thể bỏ trống hoặc bấm chọn ảnh"
                        android:inputType="textUri"
                        android:singleLine="true" />
                </com.google.android.material.textfield.TextInputLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="18dp"
                    android:orientation="horizontal">

                    <FrameLayout
                        android:id="@+id/btnUploadNewsImage"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_btn_secondary"
                        android:clickable="true"
                        android:focusable="true">

                        <TextView
                            android:id="@+id/tvUploadNewsImageText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:fontFamily="@font/be_vietnam_pro_semibold"
                            android:text="Chọn ảnh"
                            android:textColor="@color/white"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </FrameLayout>

                    <FrameLayout
                        android:id="@+id/btnAddBulletin"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_btn_primary"
                        android:clickable="true"
                        android:focusable="true">

                        <TextView
                            android:id="@+id/tvAddBulletinText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:fontFamily="@font/be_vietnam_pro_semibold"
                            android:text="Thêm bản tin"
                            android:textColor="@color/white"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </FrameLayout>
                </LinearLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/DS.TextInputLayout"
                    android:hint="Bản tin trường"
                    app:startIconDrawable="@drawable/ic_info"
                    android:layout_marginBottom="18dp">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etSchoolBulletins"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        style="@style/DS.TextInputEditText"
                        android:gravity="top"
                        android:hint="Mỗi dòng một tin, ví dụ: Lao động xanh | Chiều thứ 6 vệ sinh khu nội trú"
                        android:inputType="textMultiLine|textCapSentences"
                        android:minLines="4"
                        android:maxLines="7"
                        android:singleLine="false"/>
                </com.google.android.material.textfield.TextInputLayout>

                <FrameLayout
                    android:id="@+id/btnSaveSettings"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:background="@drawable/bg_btn_primary"
                    android:elevation="4dp"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:id="@+id/tvSaveSettingsText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Lưu cài đặt"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/white"
                        android:fontFamily="@font/be_vietnam_pro_semibold"
                        android:layout_gravity="center"/>

                    <ProgressBar
                        android:id="@+id/progressSettings"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:indeterminateTint="@color/white"
                        android:visibility="gone"/>
                </FrameLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="24dp"
                    android:layout_marginBottom="18dp"
                    android:background="@color/ds_border"/>

                <TextView
                    style="@style/DS.SectionHeader"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="DỮ LIỆU VẬN HÀNH"
                    android:layout_marginBottom="8dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Dùng khi kết thúc giai đoạn test: xoá toàn bộ báo cáo và điểm thử nghiệm, giữ nguyên tài khoản và branding."
                    android:textColor="@color/ds_text_secondary"
                    android:textSize="13sp"
                    android:fontFamily="@font/be_vietnam_pro"
                    android:lineSpacingMultiplier="1.35"
                    android:layout_marginBottom="12dp"/>

                <FrameLayout
                    android:id="@+id/btnResetData"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:background="@drawable/bg_btn_reset"
                    android:clickable="true"
                    android:focusable="true">

                    <LinearLayout
                        android:id="@+id/tvResetDataText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:src="@drawable/ic_trash"
                            android:contentDescription="Reset dữ liệu"
                            app:tint="@color/ds_error"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:fontFamily="@font/be_vietnam_pro_semibold"
                            android:text="Reset dữ liệu test"
                            android:textColor="@color/ds_error"
                            android:textSize="14sp"
                            android:textStyle="bold"/>
                    </LinearLayout>

                    <ProgressBar
                        android:id="@+id/progressResetData"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:indeterminateTint="@color/ds_error"
                        android:visibility="gone"/>
                </FrameLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</ScrollView>

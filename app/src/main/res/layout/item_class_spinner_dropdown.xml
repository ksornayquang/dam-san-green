<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="8dp"
    android:layout_marginVertical="4dp"
    android:background="@drawable/bg_class_dropdown_item"
    android:gravity="center_vertical"
    android:minHeight="58dp"
    android:orientation="horizontal"
    android:paddingHorizontal="12dp"
    android:paddingVertical="10dp">

    <TextView
        android:id="@+id/tvDropdownClassGrade"
        android:layout_width="42dp"
        android:layout_height="32dp"
        android:background="@drawable/bg_class_grade_chip"
        android:fontFamily="@font/be_vietnam_pro_bold"
        android:gravity="center"
        android:letterSpacing="0"
        android:text="K11"
        android:textColor="@color/ds_primary"
        android:textSize="11sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvDropdownClassName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/be_vietnam_pro_semibold"
            android:letterSpacing="0"
            android:maxLines="1"
            android:text="Lớp 11A1"
            android:textColor="@color/ds_text_primary"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvDropdownClassHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:fontFamily="@font/be_vietnam_pro_regular"
            android:letterSpacing="0"
            android:maxLines="1"
            android:text="Khối 11 - phụ trách mảng xanh"
            android:textColor="@color/ds_text_secondary"
            android:textSize="11sp" />
    </LinearLayout>

    <ImageView
        android:id="@+id/ivDropdownSelected"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:contentDescription="Đang chọn"
        android:src="@drawable/ic_check"
        android:visibility="invisible"
        app:tint="@color/ds_primary" />
</LinearLayout>

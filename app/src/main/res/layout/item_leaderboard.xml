<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingBottom="12dp">

    <androidx.cardview.widget.CardView
        android:id="@+id/cardView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="22dp"
        app:cardBackgroundColor="@color/eco_surface"
        app:cardElevation="2dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="16dp">

            <!-- Rank Badge -->
            <TextView
                android:id="@+id/tvRank"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_eco_rank_circle"
                android:text="1"
                android:textSize="15sp"
                android:gravity="center"
                android:textColor="@color/white"
                android:textStyle="bold"/>

            <!-- Class Info -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="14dp">

                <TextView
                    android:id="@+id/tvClassName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Lớp 11A1"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/eco_text"/>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="2dp">

                    <TextView
                        android:id="@+id/tvReportCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0 lần nhặt"
                        android:textSize="12sp"
                        android:textColor="@color/eco_primary"
                        android:textStyle="bold"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=" · "
                        android:textSize="12sp"
                        android:textColor="@color/eco_border"/>

                    <TextView
                        android:id="@+id/tvLastActivity"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textSize="12sp"
                        android:textColor="@color/eco_text_muted"/>
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/tvPoints"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="84dp"
                android:gravity="end|center_vertical"
                android:text="100"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/eco_primary"/>

        </LinearLayout>
    </androidx.cardview.widget.CardView>
</LinearLayout>

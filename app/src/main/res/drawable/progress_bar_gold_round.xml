<?xml version="1.0" encoding="utf-8"?>
<!-- Gold progress bar for leaderboard — full rounded corners -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape>
            <corners android:radius="6dp"/>
            <solid android:color="#33E5C158"/>
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <clip>
            <shape>
                <corners android:radius="6dp"/>
                <gradient
                    android:startColor="#E5C158"
                    android:endColor="#D4A932"
                    android:angle="0"/>
            </shape>
        </clip>
    </item>
</layer-list>

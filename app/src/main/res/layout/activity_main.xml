<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/mainRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- LAYER 0: Fullscreen Google Map (100% nền) -->
    <com.google.android.gms.maps.MapView
        android:id="@+id/googleMapView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.damsan.green.ui.map.Campus3DMapView
        android:id="@+id/campus3DMapView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- LAYER 1: UI Overlay -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/mainUiOverlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- ============================================ -->
        <!-- HEADER: Logo + School Name + Weather + Icons -->
        <!-- Glass frosted header bar                     -->
        <!-- ============================================ -->
        <LinearLayout
            android:id="@+id/headerBar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_header_glass"
            android:paddingTop="12dp"
            android:paddingBottom="8dp"
            android:paddingHorizontal="16dp"
            android:elevation="8dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <!-- Row 1: Logo + School Name + Bell + Menu -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <!-- Logo trường chính thức -->
                <ImageView
                    android:id="@+id/ivHeaderLogo"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:visibility="gone"
                    android:contentDescription="Logo trường PTDTNT Đam San"/>

                <!-- School name + subtitle -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="10dp">

                    <TextView
                        android:id="@+id/tvHeaderSchoolName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Trường PTDTNT Đam San"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/primary_blue"
                        android:maxLines="1"
                        android:ellipsize="end"/>

                    <TextView
                        android:id="@+id/tvHeaderAppName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Dam San Green"
                        android:textSize="12sp"
                        android:textColor="@color/primary_forest_green"
                        android:layout_marginTop="-2dp"/>

                </LinearLayout>

                <!-- Bell icon -->
                <FrameLayout
                    android:id="@+id/btnBell"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_icon_circle_glass"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackgroundBorderless">

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/ivBell"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:src="@drawable/ic_bell_3d"
                        android:scaleType="centerCrop"
                        android:layout_gravity="center"
                        app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.DamSan.Circle"/>

                    <View
                        android:id="@+id/notifDot"
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:background="@drawable/bg_red_circle"
                        android:layout_gravity="end|top"
                        android:layout_marginEnd="8dp"
                        android:layout_marginTop="8dp"
                        android:visibility="gone"/>

                </FrameLayout>

                <!-- Menu icon -->
                <FrameLayout
                    android:id="@+id/btnMainMenu"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_icon_circle_glass"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackgroundBorderless">

                    <ImageView
                        android:id="@+id/ivMenu"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_menu"
                        android:layout_gravity="center"/>

                </FrameLayout>

            </LinearLayout>

            <!-- Row 2: Weather + Location + Points -->
            <LinearLayout
                android:id="@+id/weatherInfoRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="10dp"
                android:alpha="0.9">

                <!-- Weather icon + temp -->
                <ImageView
                    android:id="@+id/ivWeatherIcon"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_weather_cloudy"/>

                <TextView
                    android:id="@+id/tvTemperature"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="--°C"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_ash_gray"
                    android:layout_marginStart="4dp"/>

                <!-- Weather desc chip -->
                <TextView
                    android:id="@+id/tvWeatherDesc"
                    android:layout_width="88dp"
                    android:layout_height="wrap_content"
                    android:text="Đang tải..."
                    android:textSize="11sp"
                    android:textColor="@color/primary_blue"
                    android:background="@drawable/bg_weather_chip"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="3dp"
                    android:layout_marginStart="8dp"
                    android:maxLines="1"
                    android:ellipsize="end"/>

                <View
                    android:layout_width="8dp"
                    android:layout_height="1dp"
                    />

                <!-- Location chip -->
                <LinearLayout
                    android:id="@+id/chipLocation"
                    android:layout_width="0dp"
                    android:layout_height="30dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_chip_glass"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="10dp"
                    android:layout_marginEnd="6dp">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_pin_3d"
                        android:scaleType="centerInside"/>

                    <TextView
                        android:id="@+id/tvLocationChip"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="EaDrông, Đắk Lắk"
                        android:textSize="11sp"
                        android:textColor="@color/text_ash_gray"
                        android:layout_marginStart="3dp"
                        android:maxLines="1"
                        android:ellipsize="end"/>

                </LinearLayout>

                <!-- Points chip -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:background="@drawable/bg_chip_gold"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="10dp">

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:src="@drawable/ic_coin"/>

                    <TextView
                        android:id="@+id/tvMyPoints"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0 Điểm"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_ash_gray"
                        android:layout_marginStart="3dp"/>

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

        <!-- Spacer — bản đồ hiện ở giữa -->
        <!-- ============================================ -->
        <!-- BOTTOM SECTION: Cards nổi từ dưới lên       -->
        <!-- ============================================ -->
        <LinearLayout
            android:id="@+id/bottomCardsPanel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingBottom="14dp"
            android:background="@drawable/bg_bottom_gradient"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <!-- Admin Card — Chỉ hiện khi role=admin -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardAdmin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="20dp"
                app:cardElevation="6dp"
                app:cardBackgroundColor="@color/accent_earth_red"
                android:layout_marginBottom="10dp"
                android:visibility="gone"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="14dp"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:src="@drawable/ic_shield"
                        android:scaleType="center"
                        android:padding="6dp"
                        android:background="@drawable/bg_icon_circle_white"
                        android:contentDescription="Admin"/>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="10dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Duyệt Rác (Admin)"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="@color/white"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Xem và duyệt báo cáo"
                            android:textSize="11sp"
                            android:textColor="#FFFFFFCC"/>
                    </LinearLayout>

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_arrow_right"
                        app:tint="@color/white"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- LEADERBOARD CARD — Full width compact -->
            <LinearLayout
                android:id="@+id/cardLeaderboard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@drawable/bg_eco_card_soft"
                android:padding="16dp"
                android:layout_marginBottom="16dp"
                android:elevation="3dp"
                android:gravity="center_vertical"
                android:clickable="true"
                android:focusable="true"
                android:descendantFocusability="blocksDescendants"
                android:foreground="?attr/selectableItemBackground">

                <!-- Trophy + Title -->
                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/ic_crown_gold_3d"
                    android:scaleType="centerInside"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="10dp">

                    <TextView
                        android:id="@+id/tvLeaderboardTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Bảng Xếp Hạng Lớp"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/eco_text"/>

                    <!-- Top 1 inline -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="6dp">

                        <TextView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:background="@drawable/bg_eco_rank_circle_dark"
                            android:text="1"
                            android:textColor="@color/white"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:gravity="center"/>

                        <TextView
                            android:id="@+id/tvRank1Name"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Đang tải..."
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="@color/eco_text"
                            android:layout_marginStart="8dp"/>

                        <View
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_weight="1"/>

                        <!-- Progress bar inline -->
                        <ProgressBar
                            android:id="@+id/progressRank1"
                            android:layout_width="80dp"
                            android:layout_height="8dp"
                            style="?android:attr/progressBarStyleHorizontal"
                            android:progressDrawable="@drawable/progress_bar_gold_round"
                            android:max="100"
                            android:progress="0"
                            android:layout_marginEnd="6dp"/>

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/ic_eco_points"/>

                        <TextView
                            android:id="@+id/tvRank1Points"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="—"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="@color/eco_primary"
                            android:layout_marginStart="4dp"/>

                    </LinearLayout>

                </LinearLayout>

                <!-- Arrow -->
                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_arrow_right"
                    android:layout_marginStart="8dp"
                    app:tint="#AAAAAA"/>

            </LinearLayout>

            <!-- IMPACT CARD - Competition-friendly environmental analytics -->
            <LinearLayout
                android:id="@+id/cardImpact"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_eco_card_soft"
                android:padding="16dp"
                android:layout_marginBottom="16dp"
                android:elevation="3dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:src="@drawable/ic_leaf_3d"
                        android:scaleType="centerInside"
                        android:padding="8dp"
                        android:background="@drawable/bg_eco_icon_chip"
                        android:contentDescription="Tác động xanh"
                        app:tint="@color/ds_primary"/>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="10dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Tác động xanh"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:fontFamily="@font/be_vietnam_pro_semibold"
                            android:textColor="@color/eco_text"
                            android:letterSpacing="0"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Số liệu tự động từ các báo cáo đã duyệt"
                            android:textSize="11sp"
                            android:fontFamily="@font/be_vietnam_pro_regular"
                            android:textColor="@color/eco_text_muted"
                            android:layout_marginTop="1dp"
                            android:letterSpacing="0"/>
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="12dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:padding="10dp"
                        android:background="@drawable/bg_eco_card">

                        <TextView
                            android:id="@+id/tvImpactCleanups"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textSize="24sp"
                            android:textStyle="bold"
                            android:fontFamily="@font/be_vietnam_pro_bold"
                            android:textColor="@color/eco_primary"
                            android:letterSpacing="0"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="lượt dọn"
                            android:textSize="10sp"
                            android:fontFamily="@font/be_vietnam_pro_regular"
                            android:textColor="@color/eco_text_muted"
                            android:letterSpacing="0"/>
                    </LinearLayout>

                    <Space
                        android:layout_width="8dp"
                        android:layout_height="1dp"/>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:padding="10dp"
                        android:background="@drawable/bg_eco_card">

                        <TextView
                            android:id="@+id/tvImpactWaste"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0 kg"
                            android:textSize="24sp"
                            android:textStyle="bold"
                            android:fontFamily="@font/be_vietnam_pro_bold"
                            android:textColor="#EF4444"
                            android:letterSpacing="0"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="rác thu gom"
                            android:textSize="10sp"
                            android:fontFamily="@font/be_vietnam_pro_regular"
                            android:textColor="@color/eco_text_muted"
                            android:letterSpacing="0"/>
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="8dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:padding="10dp"
                        android:background="@drawable/bg_eco_card">

                        <TextView
                            android:id="@+id/tvImpactCo2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0 kg"
                            android:textSize="24sp"
                            android:textStyle="bold"
                            android:fontFamily="@font/be_vietnam_pro_bold"
                            android:textColor="@color/eco_cyan"
                            android:letterSpacing="0"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="CO₂ tránh phát thải"
                            android:textSize="10sp"
                            android:fontFamily="@font/be_vietnam_pro_regular"
                            android:textColor="@color/eco_text_muted"
                            android:letterSpacing="0"/>
                    </LinearLayout>

                    <Space
                        android:layout_width="8dp"
                        android:layout_height="1dp"/>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:padding="10dp"
                        android:background="@drawable/bg_eco_card">

                        <TextView
                            android:id="@+id/tvImpactClasses"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textSize="24sp"
                            android:textStyle="bold"
                            android:fontFamily="@font/be_vietnam_pro_bold"
                            android:textColor="@color/eco_lemon"
                            android:letterSpacing="0"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="lớp tham gia"
                            android:textSize="10sp"
                            android:fontFamily="@font/be_vietnam_pro_regular"
                            android:textColor="@color/eco_text_muted"
                            android:letterSpacing="0"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- ROW: Mission (left) + CTA (right) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- MISSION CARD -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/cardTask"
                    android:layout_width="0dp"
                    android:layout_height="136dp"
                    android:layout_weight="7"
                    android:background="@drawable/bg_eco_card"
                    android:padding="12dp"
                    android:layout_marginEnd="12dp"
                    android:elevation="3dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:descendantFocusability="blocksDescendants"
                    android:foreground="?attr/selectableItemBackground">

                    <ImageView
                        android:id="@+id/ivMissionIcon"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription="Nhiệm vụ"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_heart_3d"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/tvMissionTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="Nhiệm Vụ Hôm Nay"
                        android:textColor="@color/eco_text"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        app:layout_constraintBottom_toBottomOf="@id/ivMissionIcon"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@id/ivMissionIcon"
                        app:layout_constraintTop_toTopOf="@id/ivMissionIcon" />

                    <!-- Task description -->
                    <TextView
                        android:id="@+id/tvMissionDesc"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="Đang tải..."
                        android:textSize="14sp"
                        android:textColor="@color/eco_text"
                        android:layout_marginTop="5dp"
                        android:maxLines="2"
                        android:ellipsize="end"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/ivMissionIcon" />

                    <!-- Task count -->
                    <TextView
                        android:id="@+id/tvTaskCount"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="(0/2 báo cáo)"
                        android:textSize="12sp"
                        android:textColor="@color/text_medium"
                        android:layout_marginTop="2dp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/tvMissionDesc" />

                    <!-- Progress bar -->
                    <ProgressBar
                        android:id="@+id/taskProgress"
                        android:layout_width="0dp"
                        android:layout_height="6dp"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:progressDrawable="@drawable/custom_progress_bar_bento"
                        android:max="2"
                        android:progress="0"
                        android:layout_marginTop="5dp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/tvTaskCount" />

                    <!-- Bonus mission hint -->
                    <TextView
                        android:id="@+id/tvBonusMission"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="Tiếp: Thu gom chai nhựa"
                        android:textSize="10sp"
                        android:textColor="#999999"
                        android:layout_marginTop="6dp"
                        android:maxLines="1"
                        android:ellipsize="end"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/taskProgress" />

                </androidx.constraintlayout.widget.ConstraintLayout>

                <!-- CTA BUTTON CARD -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/btnReportPill"
                    android:layout_width="0dp"
                    android:layout_height="104dp"
                    android:layout_weight="3"
                    android:background="@drawable/selector_scan_terracotta"
                    android:padding="8dp"
                    android:elevation="12dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:descendantFocusability="blocksDescendants"
                    android:foreground="?attr/selectableItemBackground">

                    <!-- Title -->
                    <TextView
                        android:id="@+id/tvScanAction"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="QUÉT RÁC"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        android:textColor="@color/white"
                        android:gravity="center"
                        android:letterSpacing="0"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toTopOf="@id/tvScanPoints"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"/>

                    <!-- Subtitle -->
                    <TextView
                        android:id="@+id/tvScanPoints"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="3–15 điểm"
                        android:textSize="10sp"
                        android:textColor="@color/text_white_secondary"
                        android:gravity="center"
                        android:layout_marginTop="2dp"
                        app:layout_constraintTop_toBottomOf="@id/tvScanAction"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"/>

                    <ImageView
                        android:id="@+id/ivScanCamera"
                        android:layout_width="46dp"
                        android:layout_height="40dp"
                        android:layout_marginTop="3dp"
                        android:contentDescription="Chụp ảnh rác"
                        android:src="@drawable/ic_camera_3d"
                        android:scaleType="centerInside"
                        app:layout_constraintTop_toBottomOf="@id/tvScanPoints"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"/>

                </androidx.constraintlayout.widget.ConstraintLayout>

            </LinearLayout>

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <LinearLayout
        android:id="@+id/mapModeToggle"
        android:layout_width="wrap_content"
        android:layout_height="42dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="150dp"
        android:background="@drawable/bg_map_mode_container"
        android:elevation="12dp"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/btnMapModeGps"
            android:layout_width="54dp"
            android:layout_height="34dp"
            android:background="@drawable/bg_map_mode_selected"
            android:fontFamily="@font/be_vietnam_pro_semibold"
            android:gravity="center"
            android:letterSpacing="0"
            android:text="GPS"
            android:textColor="@color/white"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/btnMapMode3d"
            android:layout_width="54dp"
            android:layout_height="34dp"
            android:background="@drawable/bg_map_mode_unselected"
            android:fontFamily="@font/be_vietnam_pro_semibold"
            android:gravity="center"
            android:letterSpacing="0"
            android:text="3D"
            android:textColor="@color/primary_forest_green"
            android:textSize="12sp" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/btnMapZoomIn"
        android:layout_width="46dp"
        android:layout_height="46dp"
        android:layout_marginTop="150dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/bg_icon_circle_glass"
        android:contentDescription="Phóng to bản đồ"
        android:elevation="12dp"
        android:padding="7dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_zoom_in_3d"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageButton
        android:id="@+id/btnMapZoomOut"
        android:layout_width="46dp"
        android:layout_height="46dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_icon_circle_glass"
        android:contentDescription="Thu nhỏ bản đồ"
        android:elevation="12dp"
        android:padding="7dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_zoom_out_3d"
        app:layout_constraintEnd_toEndOf="@id/btnMapZoomIn"
        app:layout_constraintStart_toStartOf="@id/btnMapZoomIn"
        app:layout_constraintTop_toBottomOf="@id/btnMapZoomIn" />

    <FrameLayout
        android:id="@+id/btnAiBubbleHome"
        android:layout_width="58dp"
        android:layout_height="58dp"
        android:layout_marginEnd="18dp"
        android:layout_marginTop="350dp"
        android:background="@drawable/bg_ai_bubble"
        android:clickable="true"
        android:elevation="14dp"
        android:focusable="true"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center"
            android:contentDescription="Trợ lý AI Đam San"
            android:src="@drawable/ic_sparkle"
            app:tint="@color/white" />
    </FrameLayout>

    <!-- Hidden views needed by code -->
    <TextView
        android:id="@+id/tvRank2Name"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:id="@+id/tvRank2Points"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ProgressBar
        android:id="@+id/progressRank2"
        android:layout_width="0dp"
        android:layout_height="0dp"
        style="?android:attr/progressBarStyleHorizontal"
        android:progressDrawable="@drawable/custom_progress_bar_green"
        android:max="100"
        android:progress="0"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>


<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.DamSanGreen" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/ds_primary</item>
        <item name="colorPrimaryVariant">@color/ds_primary_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/ds_primary_light</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorError">@color/ds_error</item>
        <item name="android:windowBackground">@color/ds_background</item>
        <item name="android:statusBarColor">@color/ds_primary</item>
        <item name="android:navigationBarColor">@color/ds_background</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">true</item>

        <!-- Global Font -->
        <item name="android:fontFamily">@font/be_vietnam_pro</item>
        <item name="fontFamily">@font/be_vietnam_pro</item>

        <!-- TextInputLayout default style -->
        <item name="textInputStyle">@style/DS.TextInputLayout</item>
    </style>

    <style name="Theme.DamSanGreen.Splash" parent="Theme.DamSanGreen">
        <item name="android:windowNoTitle">true</item>
        <item name="android:statusBarColor">@color/ds_primary</item>
    </style>

    <!-- Bo tròn thân thiện thay vì vát góc vuông -->
    <style name="ShapeAppearance.DamSan.Cut" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">20dp</item>
    </style>

    <style name="ShapeAppearance.DamSan.CutSmall" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">12dp</item>
    </style>

    <style name="ShapeAppearanceOverlay.DamSan.Circle" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <!-- Pill shape cho nút lớn -->
    <style name="ShapeAppearance.DamSan.Shield" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">34dp</item>
    </style>

    <!-- Transparent status bar cho MainActivity — Liquid Glass -->
    <style name="Theme.DamSanGreen.Map" parent="Theme.DamSanGreen">
        <item name="android:windowTranslucentStatus">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="@dimen/main_menu_width"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_glass_panel"
    android:elevation="12dp"
    android:padding="10dp">

    <LinearLayout
        android:id="@+id/menuProfile"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="12dp"
        android:background="@drawable/bg_glass_menu_item"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_profile_3d"
            android:scaleType="fitCenter"
            android:contentDescription="Hồ sơ"
            />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:fontFamily="@font/be_vietnam_pro_medium"
            android:text="Hồ sơ lớp"
            android:textColor="@color/ds_text_primary"
            android:textSize="15sp" />

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_arrow_right"
            app:tint="@color/ds_text_hint" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/menuLeaderboard"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="12dp"
        android:background="@drawable/bg_glass_menu_item"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_crown_gold_3d"
            android:scaleType="fitCenter"
            android:contentDescription="Bảng xếp hạng"
            />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:fontFamily="@font/be_vietnam_pro_medium"
            android:text="Bảng xếp hạng"
            android:textColor="@color/ds_text_primary"
            android:textSize="15sp" />

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_arrow_right"
            app:tint="@color/ds_text_hint" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/menuSchoolInfo"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="12dp"
        android:background="@drawable/bg_glass_menu_item"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_info_3d"
            android:scaleType="fitCenter"
            android:contentDescription="Giới thiệu"
            />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:fontFamily="@font/be_vietnam_pro_medium"
            android:text="Giới thiệu trường"
            android:textColor="@color/ds_text_primary"
            android:textSize="15sp" />

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_arrow_right"
            app:tint="@color/ds_text_hint" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginHorizontal="12dp"
        android:layout_marginVertical="6dp"
        android:background="@color/ds_border" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/menuLogout"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:backgroundTint="#FFF4F3"
        android:fontFamily="@font/be_vietnam_pro_semibold"
        android:text="Đăng xuất"
        android:textColor="@color/ds_error"
        android:textSize="15sp"
        app:cornerRadius="12dp"
        app:icon="@drawable/ic_logout_3d"
        app:iconGravity="textStart"
        app:iconPadding="10dp"
        app:iconSize="24dp"
        app:iconTint="@null" />
</LinearLayout>
